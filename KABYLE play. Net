<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>KABYLE Play</title>
  <style>
    * {margin: 0; padding: 0; box-sizing: border-box;}
    body {
      background-color: #0b3d0b;
      font-family: Arial, sans-serif;
      color: white;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 40px;
      background: rgba(0,0,0,0.8);
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
    }

    header h1 {
      color: #0f0; 
    }

    nav a {
      margin: 0 15px;
      text-decoration: none;
      color: white;
      font-weight: bold;
    }

    .hero {
      height: 80vh;
      background: url("https://i.ibb.co/njHnCWW/cinema-bg.jpg") no-repeat center/cover;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 0 20px;
    }

    .hero h2 {
      font-size: 3em;
      margin-bottom: 20px;
    }

    .hero button {
      padding: 12px 30px;
      font-size: 1.2em;
      background: #0f0;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }

    .catalogue {
      padding: 80px 40px 40px;
    }

    .catalogue h3 {
      margin-bottom: 20px;
      font-size: 1.8em;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 15px;
    }

    .card {
      background: #222;
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.3s;
    }

    .card:hover {
      transform: scale(1.05);
    }

    .card img {
      width: 100%;
      height: 260px;
      object-fit: cover;
    }

    footer {
      text-align: center;
      padding: 20px;
      background: black;
      margin-top: 40px;
    }
  </style>
</head>
<body>
  <header>
    <h1>KABYLE Play</h1>
    <nav>
      <a href="#">Accueil</a>
      <a href="#">Films</a>
      <a href="#">Séries</a>
      <a href="#">Mon Compte</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Bienvenue sur KABYLE Play</h2>
    <p>Regardez vos films et séries préférés en un clic</p>
    <button>Commencer</button>
  </section>

  <section class="catalogue">
    <h3>Films Populaires</h3>
    <div class="grid">
      <div class="card"><img src="https://i.ibb.co/4sZZvDy/movie1.jpg" alt="Film 1"></div>
      <div class="card"><img src="https://i.ibb.co/L0kPgBp/movie2.jpg" alt="Film 2"></div>
      <div class="card"><img src="https://i.ibb.co/z72m6Y4/movie3.jpg" alt="Film 3"></div>
      <div class="card"><img src="https://i.ibb.co/2PSKcFb/movie4.jpg" alt="Film 4"></div>
    </div>
  </section>

  <section class="catalogue">
    <h3>Séries Recommandées</h3>
    <div class="grid">
      <div class="card"><img src="https://i.ibb.co/f4HYPY8/serie1.jpg" alt="Série 1"></div>
      <div class="card"><img src="https://i.ibb.co/m92Y02V/serie2.jpg" alt="Série 2"></div>
      <div class="card"><img src="https://i.ibb.co/fG3fXq1/serie3.jpg" alt="Série 3"></div>
      <div class="card"><img src="https://i.ibb.co/2jnF4c8/serie4.jpg" alt="Série 4"></div>
    </div>
  </section>

  <footer>
    <p>© 2025 KABYLE Play - Tous droits réservés</p>
  </footer>
</body>
</html>
